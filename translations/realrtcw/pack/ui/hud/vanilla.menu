// SURVIVAL //

	menuDef {
    	name "Survival"
    	fullScreen MENU_FALSE
    	visible MENU_TRUE
    	rect 213 438 372 32
		
		// SCORE VALUE
		itemDef {
 			name "score_value"
			
			cvarTest "g_gameType"
			showCvar { "3" }
			
			rect -80 -12 32 32
			
			textScale .42
			textStyle ITEM_TEXTSTYLE_SHADOWEDMORE
			
			foreColor .63 .59 .57 1	// grey
			
			decoration
			visible MENU_TRUE
			
			ownerDraw CG_PLAYER_SCORE
		}
		
		// SCORE TEXT
		itemDef {
 			name "score_text"
			type 1
			
			cvarTest "g_gameType"
			showCvar { "3" }
			
			rect -64 32 32 32
			
			text "@SURV_SCORE"
			textAlign ITEM_ALIGN_CENTER
			textFont UI_FONT_NORMAL
			textScale .15
			textStyle 6
			
			backColor .4 .4 .4 .6 
			foreColor .63 .59 .57 1	// grey
			
			decoration
			visible 1
		}
		
		// WAVES VALUE
		itemDef {
 			name "waves_value"
			
			cvarTest "g_gameType"
			showCvar { "3" }
			
			rect -16 -12 32 32
			
			textScale .42
			textStyle ITEM_TEXTSTYLE_SHADOWEDMORE
			
			foreColor .63 .59 .57 1	// grey
			
			decoration
			visible MENU_TRUE
			
			ownerDraw CG_PLAYER_WAVES
		}
		
		// WAVES TEXT
		itemDef {
 			name "waves_text"
			type 1
			
			cvarTest "g_gameType"
			showCvar { "3" }
			
			rect 0 32 32 32
			
			text "@SURV_WAVE"
			textAlign ITEM_ALIGN_CENTER
			textFont UI_FONT_NORMAL
			textScale .15
			textStyle 6
			
			backColor .4 .4 .4 .6 
			foreColor .63 .59 .57 1	// grey
			
			decoration
			visible 1
		}
		
		// KILLS VALUE
		itemDef {
 			name "kills_value"
			
			cvarTest "g_gameType"
			showCvar { "3" }
			
			rect 48 -12 32 32
			
			textScale .42
			textStyle ITEM_TEXTSTYLE_SHADOWEDMORE
			
			foreColor .63 .59 .57 1	// grey
			
			decoration
			visible MENU_TRUE
			
			ownerDraw CG_PLAYER_KILLS
		}
		
		// KILLS TEXT
		itemDef {
 			name "kills_text"
			type 1
			
			cvarTest "g_gameType"
			showCvar { "3" }
			
			rect 64 32 32 32
			
			text "@SURV_KILLS"
			textAlign ITEM_ALIGN_CENTER
			textFont UI_FONT_NORMAL
			textScale .15
			textStyle 6
			
			backColor .4 .4 .4 .6 
			foreColor .63 .59 .57 1	// grey
			
			decoration
			visible 1
		}
	}
	
