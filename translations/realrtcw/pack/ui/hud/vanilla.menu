		chairHint			"gfx/2d/vanilla/usableHint.tga"
		healthHint			"gfx/2d/vanilla/usableHint.tga"
		holdableHint		"gfx/2d/vanilla/usableHint.tga"
		inventoryHint		"gfx/2d/vanilla/usableHint.tga"
		powerupHint			"gfx/2d/vanilla/usableHint.tga"
		treasureHint		"gfx/2d/vanilla/usableHint.tga"
