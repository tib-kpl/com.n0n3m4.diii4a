		youGotMail			"gfx/2d/vanilla/youGotMail.tga"
		youGotObjective		"gfx/2d/vanilla/youGotObjective.tga"
		
		friendlyCross		"gfx/2d/friendlyCross.tga"

		cursor "ui/assets/3_cursor3"				// cursor	
		gradientBar "ui/assets/gradientbar2.tga"	// gradient bar

		fadeClamp 1.0								// sets the fadeup alpha
		fadeCycle 1									// how often fade happens in milliseconds
		fadeAmount 0.1								// amount to adjust alpha per cycle

		shadowX  5									// x amount for shadow offset
		shadowY  5									// y amount for shadow offset
		shadowColor 0.1 0.1 0.1 0.25				// shadow color
	}
							   
	//	PLAYER STATUS	//
	menuDef {
    	name "Status"
    	fullScreen MENU_FALSE
    	visible MENU_TRUE
    	rect 40 438 172 32

		// health text
		itemDef {
 			name "a"
			
			cvarTest "cg_hudStatus"
			showCvar { "3" }
			// Health & Armor Values
			
			rect 5 0 32 32
			visible MENU_TRUE
			textstyle ITEM_TEXTSTYLE_SHADOWEDMORE
			decoration
			textscale .5
//			forecolor .63 .47 .25 1
			forecolor 1 1 1 1
			ownerdraw CG_PLAYER_HEALTH
			addColorRange 10 999 .63 .47 .25 1	// healthy
			addColorRange -999 10 1 0 0 1	// hurting
		}

		// health text
		itemDef {
 			name "a"
			
			cvarTest "cg_hudStatus"
			showCvar { "5" }
			// Health & Armor Bars + Values
			
			rect 25 0 32 32
			visible MENU_TRUE
			textstyle ITEM_TEXTSTYLE_SHADOWEDMORE
			decoration
			textscale .5
//			forecolor .63 .47 .25 1
			forecolor 1 1 1 1
			ownerdraw CG_PLAYER_HEALTH
			addColorRange 10 999 .63 .47 .25 1	// healthy
			addColorRange -999 10 1 0 0 1	// hurting
		}

		// armor text
		itemDef {
 			name "a"
			
			cvarTest "cg_hudStatus"
			showCvar { "0" }
			// Armor Value
			
			rect 5 0 32 32
			visible MENU_TRUE
			textstyle ITEM_TEXTSTYLE_SHADOWEDMORE
			decoration
			textscale .5
			forecolor .34 .35 .24 1
			ownerdraw CG_PLAYER_ARMOR_VALUE
			addColorRange -999 999 .34 .35 .24 1
		}

		// armor text
		itemDef {
 			name "a"
			
			cvarTest "cg_hudStatus"
			showCvar { "2" }
			// Armor Bar + Value
			
			rect 25 0 32 32
			visible MENU_TRUE
			textstyle ITEM_TEXTSTYLE_SHADOWEDMORE
			decoration
			textscale .5
			forecolor .34 .35 .24 1
			ownerdraw CG_PLAYER_ARMOR_VALUE
			addColorRange -999 999 .34 .35 .24 1
		}

		// armor text
		itemDef {
 			name "a"
			
			cvarTest "cg_hudStatus"
			showCvar { "3" }
			// Health & Armor Values
			
			rect 140 0 32 32
			visible MENU_TRUE
			textstyle ITEM_TEXTSTYLE_SHADOWEDMORE
			decoration
			textscale .5
			forecolor .34 .35 .24 1
			ownerdraw CG_PLAYER_ARMOR_VALUE
			addColorRange -999 999 .34 .35 .24 1
		}

		// armor text
		itemDef {
 			name "a"
			
			cvarTest "cg_hudStatus"
			showCvar { "5" }
			// Health & Armor Bars + Values
			
			rect 160 0 32 32
			visible MENU_TRUE
			textstyle ITEM_TEXTSTYLE_SHADOWEDMORE
			decoration
			textscale .5
			forecolor .34 .35 .24 1
			ownerdraw CG_PLAYER_ARMOR_VALUE
			addColorRange -999 999 .34 .35 .24 1
		}
	}


	// STAMINA BAR	//
	menuDef {
    	name "Stamina"
		fullScreen MENU_FALSE
    	visible MENU_TRUE
		style WINDOW_STYLE_EMPTY
		border 1
		bordersize 1
		//bordercolor .34 .35 .24 1
		bordercolor 0 0 0 0
    	rect 10 388 10 70
		
		itemDef {
			name "ic_stamina"
			
			cvarTest "cg_hudStamina"
			showCvar { "1" }
			
			rect -2 72 12 12
			style WINDOW_STYLE_SHADER
			background "gfx/hud/et/ic_stamina"
			visible	1
			decoration
		}

		itemDef {
 			name "border"
			
			cvarTest "cg_hudStamina"
			showCvar { "1" }
			
			type 1
			rect -2 -2 10 70
			border 1
			bordersize 1
			bordercolor .34 .35 .24 1
			visible 1
			decoration
		}

		itemDef {
			name "stambar"
			
			cvarTest "cg_hudStamina"
			showCvar { "1" }
		
			decoration
			visible MENU_TRUE
			rect 0 0 8 68
			ownerdraw CG_STAMINA
			addColorRangerel 0.0 0.25	1 0.1 0.1 0.5	// 0-25%
			addColorRangerel 0.25 1.0	0.1 1 0.1 0.5	// 25-100%
		}
	}


	//	HEALTH & ARMOR BAR(S)	//
	menuDef {
    	name "HealthArmor"
		fullScreen MENU_FALSE
    	visible MENU_TRUE
		style WINDOW_STYLE_EMPTY
		border 1
		bordersize 1
		//bordercolor .34 .35 .24 1
		bordercolor 0 0 0 0
    	rect 30 388 10 70
		
		itemDef {
			name "ic_health"
				
			cvarTest "cg_hudStatus"
			showCvar { "1"; "2"; "4"; "5" }
			
			rect -2 72 12 12
			style WINDOW_STYLE_SHADER
			background "gfx/hud/et/ic_health"
			visible	1
			decoration
		}

		itemDef {
 			name "border"
			
			cvarTest "cg_hudStatus"
			showCvar { "1"; "2"; "4"; "5" }
			
			type 1
			rect -2 -2 10 70
			border 1
			bordersize 1
			bordercolor .34 .35 .24 1
			visible 1
			decoration
		}

		itemDef {
			name "healthbar"
			
			cvarTest "cg_hudStatus"
			showCvar { "4"; "5" }
			// Health & Armor Bars
			// Health & Armor Bars + Values
			
			decoration
			visible MENU_TRUE
			rect 0 0 8 68
			ownerdraw CG_PLAYER_HEALTH_BAR
		}

		itemDef {
			name "armorbar"
			
			cvarTest "cg_hudStatus"
			showCvar { "4"; "5" }
			// Health & Armor Bars
			// Health & Armor Bars + Values
			
			decoration
			visible MENU_TRUE
			rect 0 0 4 68
			ownerdraw CG_PLAYER_ARMOR_VALUE_BAR
			forecolor 0.45 0.45 0.45 0.5
		}

		itemDef {
			name "armorbar"
			
			cvarTest "cg_hudStatus"
			showCvar { "1"; "2" }
			// Armor Bar
			// Armor Bar + Value
			
			decoration
			visible MENU_TRUE
			rect 0 0 8 68
			ownerdraw CG_PLAYER_ARMOR_VALUE_BAR
			forecolor 1 1 1 0.5
		}
	}


