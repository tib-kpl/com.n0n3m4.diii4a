		notUsableHint		"gfx/2d/vanilla/notUsableHint.tga"
		usableHint			"gfx/2d/vanilla/usableHint.tga"
		
		alarmHint			"gfx/2d/vanilla/usableHint.tga"
		ammoHint			"gfx/2d/vanilla/usableHint.tga"
		armorHint			"gfx/2d/vanilla/usableHint.tga"
