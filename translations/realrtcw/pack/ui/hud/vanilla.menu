		cautionHint			"gfx/2d/et/buildHint.tga"			// Build (Disarm)
		dangerHint			"gfx/2d/et/dynamiteHint.tga"		// Dynamite
		exclamationHint		"gfx/2d/et/reviveHint.tga"			// Revive

	//	hintPlrEnemy		"gfx/2d/et/landmineHint.tga"		// Landmine
