		handwritingFont "fonts/handfont" 17
		bigFont "fonts/bigfont" 24
		
		// hints
		breakableHint		"gfx/2d/vanilla/breakableHint.tga"
		clipboardHint		"gfx/2d/vanilla/usableHint.tga"
		doorHint			"gfx/2d/vanilla/usableHint.tga"
		doorLockHint		"gfx/2d/et/lockedHint.tga"
		doorRotateHint		"gfx/2d/vanilla/usableHint.tga"
		doorRotateLockHint	"gfx/2d/et/lockedHint.tga"
		exitHint			"gfx/2d/vanilla/exitHint.tga"
		knifeHint			"gfx/2d/vanilla/knifeHint.tga"
		ladderHint			"gfx/2d/vanilla/ladderHint.tga"
	//	friendHint			"gfx/2d/speechHint.tga"
		speakHint			"gfx/2d/speechHint.tga"
		mg42Hint			"gfx/2d/vanilla/usableHint.tga"
