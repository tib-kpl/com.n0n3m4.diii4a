diff --git a/game/server/ai_basenpc.cpp b/game/server/ai_basenpc.cpp
index 0acc458f..cc6fe8ee 100644
--- a/game/server/ai_basenpc.cpp
+++ b/game/server/ai_basenpc.cpp
@@ -14129,3 +14129,71 @@ bool CAI_BaseNPC::IsInChoreo() const
 {
 	return m_bInChoreo;
 }
+
+#ifdef _DIII4A
+//karin: the gamepad aim assist's targets (common/aimassist/q3e_aimassist.h), for the client library of the same game,
+// which runs in the same process (single player, listen server): the local player's eye, and the enemies they see ahead,
+// NPCs hostile to them (not Alyx, nor the rebels...) and, in multiplayer, the other players not on their team: point to
+// aim at (chest) and body radius. Returns their number, -1 without a local player (a remote server)
+extern "C" __attribute__((visibility("default"))) int Q3E_SourceAimAssistTargets( float eye[3], float (*targets)[4], int maxTargets )
+{
+	CBasePlayer *pPlayer = gpGlobals->maxClients <= 1 ? UTIL_GetLocalPlayer() : UTIL_GetListenServerHost();
+	if ( !pPlayer )
+		return -1;
+
+	const Vector vecEye = pPlayer->EyePosition();
+	eye[0] = vecEye.x;
+	eye[1] = vecEye.y;
+	eye[2] = vecEye.z;
+	if ( !pPlayer->IsAlive() )
+		return 0;
+
+	Vector vecForward;
+	pPlayer->EyeVectors( &vecForward );
+
+	int numTargets = 0;
+	auto addTarget = [&]( CBaseCombatCharacter *pTarget )
+	{
+		if ( numTargets >= maxTargets )
+			return;
+		Vector vecAim = pTarget->BodyTarget( vecEye, false );
+		Vector vecDir = vecAim - vecEye;
+		float flDist = VectorNormalize( vecDir );
+		// ahead only (the assist zone is at most 15 degrees wide), before the line of sight trace
+		if ( flDist > 4096.0f || DotProduct( vecDir, vecForward ) < 0.7f )
+			return;
+		if ( !pPlayer->FVisible( pTarget ) )
+			return;
+		const Vector &vecMins = pTarget->CollisionProp()->OBBMins();
+		const Vector &vecMaxs = pTarget->CollisionProp()->OBBMaxs();
+		targets[numTargets][0] = vecAim.x;
+		targets[numTargets][1] = vecAim.y;
+		targets[numTargets][2] = vecAim.z;
+		targets[numTargets][3] = 0.5f * MAX( vecMaxs.x - vecMins.x, vecMaxs.y - vecMins.y );
+		numTargets++;
+	};
+
+	CAI_BaseNPC **ppAIs = g_AI_Manager.AccessAIs();
+	for ( int i = 0; i < g_AI_Manager.NumAIs(); i++ )
+	{
+		CAI_BaseNPC *pNPC = ppAIs[i];
+		if ( !pNPC || !pNPC->IsAlive() || pNPC->IsEffectActive( EF_NODRAW ) )
+			continue;
+		if ( pNPC->IRelationType( pPlayer ) != D_HT )
+			continue;
+		addTarget( pNPC );
+	}
+
+	for ( int i = 1; i <= gpGlobals->maxClients; i++ )
+	{
+		CBasePlayer *pOther = UTIL_PlayerByIndex( i );
+		if ( !pOther || pOther == pPlayer || !pOther->IsAlive() )
+			continue;
+		if ( g_pGameRules && g_pGameRules->IsTeamplay() && pOther->GetTeamNumber() == pPlayer->GetTeamNumber() )
+			continue;
+		addTarget( pOther );
+	}
+
+	return numTargets;
+}
+#endif
