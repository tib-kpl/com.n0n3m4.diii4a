index 69a882b6..bd096d5d 100644
--- a/game/client/in_main.cpp
+++ b/game/client/in_main.cpp
@@ -45,6 +45,71 @@ extern ConVar cam_idealyaw;
 // For showing/hiding the scoreboard
 #include <game/client/iviewport.h>
 
+#ifdef _DIII4A //karin: the gamepad aim assist of the launcher's controller settings, with its tracking
+#include <dlfcn.h>
+#include <link.h>
+#include "aimassist/q3e_aimassist.h"
+
+// the targets come from the server library of the same game (game/server/ai_basenpc.cpp), which knows the NPCs hostile
+// to the player: single player and listen server, in the same process
+typedef int (*Q3E_SourceAimAssistTargets_f)( float eye[3], float (*targets)[4], int maxTargets );
+
+static int Q3E_FindServerAimAssistTargets( struct dl_phdr_info *info, size_t size, void *data )
+{
+	if ( !info->dlpi_name || !strstr( info->dlpi_name, "libsource_server" ) )
+		return 0;
+	void *lib = dlopen( info->dlpi_name, RTLD_NOW | RTLD_NOLOAD );
+	if ( !lib )
+		return 0;
+	void *sym = dlsym( lib, "Q3E_SourceAimAssistTargets" );
+	dlclose( lib ); // NOLOAD added a reference
+	if ( !sym )
+		return 0;
+	*(void **)data = sym;
+	return 1;
+}
+
+// before: the view angles before this frame's look input, which the engine's view angles now include
+static void Q3E_SourceAimAssist( const QAngle &before, float frametime )
+{
+	static Q3E_SourceAimAssistTargets_f s_pfnTargets = NULL;
+	if ( !Q3E_AimAssist_Level() )
+		return;
+	if ( !s_pfnTargets )
+	{
+		dl_iterate_phdr( Q3E_FindServerAimAssistTargets, (void *)&s_pfnTargets );
+		if ( !s_pfnTargets )
+			return; // no local server (remote game)
+	}
+
+	float eye[3];
+	float found[Q3E_AIMASSIST_MAX_TARGETS][4];
+	int numFound = s_pfnTargets( eye, found, Q3E_AIMASSIST_MAX_TARGETS );
+	if ( numFound < 0 )
+		return;
+	q3e_aimTarget_t targets[Q3E_AIMASSIST_MAX_TARGETS];
+	for ( int i = 0; i < numFound; i++ )
+	{
+		targets[i].origin[0] = found[i][0];
+		targets[i].origin[1] = found[i][1];
+		targets[i].origin[2] = found[i][2];
+		targets[i].radius = found[i][3];
+	}
+
+	QAngle after;
+	engine->GetViewAngles( after );
+	float aim[2] = { before[PITCH], before[YAW] };
+	float delta[2] = { after[PITCH] - before[PITCH], Q3E_AimAssist_Normalize180( after[YAW] - before[YAW] ) };
+	// the server already kept the visible ones
+	if ( Q3E_AimAssist_Apply( eye, aim, delta, frametime, targets, numFound, NULL, NULL ) )
+	{
+		after[PITCH] = clamp( before[PITCH] + delta[0], -89.0f, 89.0f );
+		after[YAW] = before[YAW] + delta[1];
+		engine->SetViewAngles( after );
+	}
+}
+#endif
+
