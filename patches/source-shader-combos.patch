+//-----------------------------------------------------------------------------
+// The engine's dynamic combo index -> the .vcs file's (a newer layout, see LoadAndCreateShaders)
+//-----------------------------------------------------------------------------
+int CShaderManager::DynamicComboIndex( const ShaderLookup_t &lookup, int nIndex )
+{
+	const ShaderStaticCombos_t &combos = lookup.m_ShaderStaticCombos;
+	const ShaderComboLayouts_t *pLayouts = combos.m_pComboLayouts;
+	if ( !pLayouts || nIndex < 0 )
+		return nIndex;
+	int nNewIndex = RemapShaderComboIndex( nIndex, pLayouts->m_pEngineDynamic, pLayouts->m_nEngineDynamic,
+		pLayouts->m_pNewDynamic, combos.m_nNewDynamicVars, ShaderAPI()->GetPixelFogCombo() );
+	return nNewIndex >= 0 && nNewIndex < combos.m_nCount ? nNewIndex : 0;
+}
