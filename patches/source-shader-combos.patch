+//karin: combos of the .vcs files newer than this engine (Half-Life 2 20th anniversary, SDK 2013 of 2025), see shadercomboremap.h
+static const ShaderComboLayouts_t *FindShaderComboLayouts( const char *pShaderName )
+{
+	for ( int i = 0; i < ARRAYSIZE( s_ShaderComboLayouts ); i++ )
+	{
+		if ( !Q_stricmp( s_ShaderComboLayouts[i].m_pShaderName, pShaderName ) )
+			return &s_ShaderComboLayouts[i];
+	}
+	return NULL;
+}
+
+static uint64 ShaderComboCount( const ShaderComboVar_t *pVars, int nVars )
+{
+	uint64 nCount = 1;
+	for ( int i = 0; i < nVars; i++ )
+		nCount *= pVars[i].m_nCount;
+	return nCount;
+}
+
+// the number of first variables of the new layout making nCount combos (times nFactor, modulo 2^32 as the header's total), -1: none
+static int ShaderComboLayoutPrefix( const ShaderComboVar_t *pVars, int nVars, uint64 nFactor, uint32 nCount )
+{
+	int nPrefix = -1;
+	uint64 nProduct = 1;
+	for ( int i = 0; ; i++ )
+	{
+		if ( (uint32)( nProduct * nFactor ) == nCount )
+			nPrefix = i;
+		if ( i == nVars )
+			break;
+		nProduct *= pVars[i].m_nCount;
+	}
+	return nPrefix;
+}
+
+// index in the engine's layout -> index in the first nTo variables of the new one, by the variables' names: a new variable
+// is 0, the pixel fog type the current one (nPixelFog >= 0); -1 if a value is out of its new range
+static int RemapShaderComboIndex( int nIndex, const ShaderComboVar_t *pFrom, int nFrom, const ShaderComboVar_t *pTo, int nTo, int nPixelFog )
+{
+	int nValues[64];
+	if ( nFrom > ARRAYSIZE( nValues ) )
+		return -1;
+	for ( int i = 0; i < nFrom; i++ )
+	{
+		nValues[i] = nIndex % pFrom[i].m_nCount;
+		nIndex /= pFrom[i].m_nCount;
+	}
+
+	int nResult = 0;
+	int nMultiplier = 1;
+	for ( int j = 0; j < nTo; j++ )
+	{
+		int nValue = 0;
+		bool bFound = false;
+		for ( int i = 0; i < nFrom; i++ )
+		{
+			if ( pFrom[i].m_pName && pTo[j].m_pName && !Q_strcmp( pFrom[i].m_pName, pTo[j].m_pName ) )
+			{
+				nValue = nValues[i];
+				bFound = true;
+				break;
+			}
+		}
+		if ( !bFound && nPixelFog >= 0 && pTo[j].m_pName && !Q_strcmp( pTo[j].m_pName, "PIXELFOGTYPE" ) )
+			nValue = nPixelFog;
+		if ( nValue >= pTo[j].m_nCount )
+			return -1;
+		nResult += nValue * nMultiplier;
+		nMultiplier *= pTo[j].m_nCount;
+	}
+	return nResult;
+}
