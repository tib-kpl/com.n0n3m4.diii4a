diff --git a/engine/engine_main.inc b/engine/engine_main.inc
index 86272d46..ddf62b7e 100644
--- a/engine/engine_main.inc
+++ b/engine/engine_main.inc
@@ -43,6 +43,9 @@ inline void Q3E_Engine_AnalogEvent()
 #include "ienginetoolinternal.h"
 
 extern IGameConsole *staticGameConsole;
+#include <GameUI/IGameUI.h>
+#include <vgui/ISurface.h>
+extern IGameUI *staticGameUIFuncs;
 inline void Q3E_Engine_SyncState()
 {
 // Game states
@@ -61,12 +64,24 @@ inline void Q3E_Engine_SyncState()
 		int state = STATE_GAME;
 		auto panel = engineVGui->GetPanel(PANEL_CLIENTDLL);
 		bool inGame = cl.IsActive() && (panel && vgui::ipanel()->IsVisible(panel));
-		if(!inGame)
+		bool consoleVisible = staticGameConsole && staticGameConsole->IsConsoleVisible();
+		//karin: the game UI over a level is a menu too: the pause menu, and the main menu over its background map (Half-Life 2
+		// and its episodes). Neither the game UI root panel (always visible here), nor the client panel, nor the main menu
+		// panel (visible in game too) tell it: the mouse cursor does, shown in the menus and hidden in game
+		bool gameUI = engineVGui->IsGameUIVisible();
+		bool cursor = vgui::surface()->IsCursorVisible();
+		bool mainMenu = staticGameUIFuncs && staticGameUIFuncs->IsMainMenuVisible();
+		bool background = sv.IsLevelMainMenuBackground();
+		if(!inGame && consoleVisible)
+			state = STATE_CONSOLE;
+		else if(!consoleVisible && gameUI && (!inGame || cursor || background))
+			state = STATE_MENU;
+		static int s_lastFlags = -1;
+		int flags = state | (inGame << 8) | (consoleVisible << 9) | (gameUI << 10) | (cursor << 11) | (mainMenu << 12) | (background << 13);
+		if(flags != s_lastFlags)
 		{
-			if(staticGameConsole && staticGameConsole->IsConsoleVisible())
-				state = STATE_CONSOLE;
-			else if(engineVGui->IsGameUIVisible())
-				state = STATE_MENU;
+			Msg("Q3E state %d (in game %d, console %d, game UI %d, cursor %d, main menu %d, background level %d)\n", state, inGame, consoleVisible, gameUI, cursor, mainMenu, background);
+			s_lastFlags = flags;
 		}
 		SyncState_f(state);
     }
diff --git a/engine/vgui_baseui_interface.cpp b/engine/vgui_baseui_interface.cpp
index 9fa8c899..86fd7f9f 100644
--- a/engine/vgui_baseui_interface.cpp
+++ b/engine/vgui_baseui_interface.cpp
@@ -1572,6 +1572,28 @@ bool CEngineVGui::Key_Event( const InputEvent_t &event )
 		return true;
 #endif
 			   
+#ifdef _DIII4A
+	//karin: ESCAPE (the app's gamepad B in the menus) closes the game UI's open dialog first (options, new game...), as
+	// a back key: the dialog that has the focus, a popup of the game UI; not its main menu
+	if ( bDown && code == KEY_ESCAPE && IsGameUIVisible() && staticGameUIPanel )
+	{
+		vgui::VPANEL root = staticGameUIPanel->GetVPanel();
+		for ( vgui::VPANEL panel = vgui::input()->GetFocus(); panel; panel = vgui::ipanel()->GetParent( panel ) )
+		{
+			if ( !vgui::ipanel()->IsPopup( panel ) )
+				continue;
+			const char *className = vgui::ipanel()->GetClassName( panel );
+			if ( vgui::ipanel()->HasParent( panel, root ) && className
+				&& Q_stricmp( className, "CGameMenu" ) && Q_stricmp( className, "Menu" ) && Q_stricmp( className, "CBasePanel" ) )
+			{
+				vgui::ivgui()->PostMessage( panel, new KeyValues( "Close" ), NULL );
+				return true;
+			}
+			break;
+		}
+	}
+#endif
+
 	// ESCAPE toggles game ui
 	if ( bDown && ( code == KEY_ESCAPE || code == KEY_XBUTTON_START || code == STEAMCONTROLLER_START) && !g_ClientDLL->HandleUiToggle() )
 	{
